{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/(.*)$",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' blob: https://rjzmcwfwfxtktuleqzgf.supabase.co; font-src 'self'; connect-src 'self' https://rjzmcwfwfxtktuleqzgf.supabase.co; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains"
      },
      "continue": true
    },
    {
      "src": "^/assets/(.*)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/admin(?:/.*)?$",
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "src": "^/(?:_app\\.html|404\\.html|_pages/.*|api/.*)$",
      "headers": { "X-Robots-Tag": "noindex" },
      "continue": true
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": { "Location": "/" }
    },
    {
      "src": "^/(.+)/$",
      "status": 308,
      "headers": { "Location": "/$1" }
    },
    { "handle": "filesystem" },
    {
      "src": "^/assets/.*$",
      "status": 404,
      "headers": { "Cache-Control": "no-store" },
      "dest": "/404.html"
    },
    { "src": "^/noticias$", "dest": "/_pages/noticias.html" },
    { "src": "^/eventos$", "dest": "/_pages/eventos.html" },
    { "src": "^/torneos$", "dest": "/_pages/torneos.html" },
    {
      "src": "^/noticias/(?<id>[^/]+)$",
      "dest": "/api/seo?kind=news&id=$id"
    },
    {
      "src": "^/torneos/anual/(?<id>[^/]+)$",
      "dest": "/api/seo?kind=annual&id=$id"
    },
    {
      "src": "^/torneos/(?<id>[^/]+)$",
      "dest": "/api/seo?kind=tournament&id=$id"
    },
    { "src": "^/sitemap\\.xml$", "dest": "/api/seo?kind=sitemap" },
    { "src": "^/admin(?:/.*)?$", "dest": "/_app.html" },
    { "src": "^/.*$", "status": 404, "dest": "/404.html" }
  ]
}
