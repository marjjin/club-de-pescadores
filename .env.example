# Copy this file to .env.local and enter your project's public configuration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://www.clubdepescadores.com

# Cloudflare Turnstile site key (public, starts with 0x) for the panel login and
# password recovery. Its secret key goes only in Supabase: Authentication ->
# Attack Protection. Leave it empty locally to sign in without CAPTCHA.
VITE_TURNSTILE_SITE_KEY=

# VITE_* values are public. Never put database passwords, sb_secret_* or
# service_role keys here. Use the sb_publishable_* key from Supabase.
